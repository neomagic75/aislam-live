{
  "name": "aislam-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "validate": "node scripts/validate-app.mjs",
    "probe": "node --env-file-if-exists=.env.local scripts/probe.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": "24.x"
  },
  "license": "MIT"
}
